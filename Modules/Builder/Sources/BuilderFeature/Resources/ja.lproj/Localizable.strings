/* Builder Feature text. Keys are the English text in the Swift source. */

"Build" = "ビルド";
"Build the IPA" = "IPAをビルド";
"Download the IPA" = "IPAをダウンロード";
"Send to SideStore or AltStore" = "SideStoreまたはAltStoreへ送る";
"No build requested yet" = "まだビルドを依頼していません";
