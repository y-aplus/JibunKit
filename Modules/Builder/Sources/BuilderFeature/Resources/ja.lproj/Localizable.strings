"Building since %@" = "%@からビルド中";
"Built at %@" = "%@にビルド完了";
"The build failed" = "ビルドに失敗しました";
"Open the run on GitHub" = "GitHubで実行結果を開く";
"Enter the repository and a GitHub token below first." = "先に下でリポジトリとGitHubトークンを入力してください。";
"Repository" = "リポジトリ";
"OWNER/REPO" = "OWNER/REPO";
"Branch" = "ブランチ";
"GitHub token" = "GitHubトークン";
"Token saved; enter to replace" = "トークン保存済み（入力すると置き換え）";
"Save" = "保存";
"Saved" = "保存しました";
"Remove the Token" = "トークンを削除";
"Removed the token" = "トークンを削除しました";
