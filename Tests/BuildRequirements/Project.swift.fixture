import ProjectDescription
import ProjectDescriptionHelpers

let build = try FeatureBuildConfiguration(features: [
    .init(owner: "camera", infoPlist: [
        "NSCameraUsageDescription": "Take photos", "UIBackgroundModes": ["audio"],
    ], entitlements: ["com.apple.security.application-groups": ["group.com.jibunkit.build-camera"]]),
    .init(owner: "scanner", infoPlist: [
        "NSCameraUsageDescription": "Scan documents", "UIBackgroundModes": ["processing", "audio"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.jibunkit.build-scanner.refresh"],
    ]),
], infoPlistResolutions: ["NSCameraUsageDescription": "Camera takes photos; Scanner scans documents"])
    .compose(infoPlist: ["UILaunchScreen": [:]], entitlements: [
        "com.apple.security.application-groups": ["group.com.jibunkit.shared"],
    ])

let project = Project(name: "BuildRequirementProbe", targets: [
    .target(name: "BuildRequirementProbe", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.build-probe", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: build.infoPlist), sources: ["App.swift"],
        entitlements: .dictionary(build.entitlements))
])
