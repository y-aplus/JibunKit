import ProjectDescription
import ProjectDescriptionHelpers

let build = try FeatureBuildConfiguration(features: [
    .init(owner: "camera", infoPlist: [
        "NSCameraUsageDescription": "Take photos", "UIBackgroundModes": ["audio"],
        "CFBundleURLTypes": [["CFBundleURLName": "com.jibunkit.camera", "CFBundleURLSchemes": ["camera", "shared"],
                              "CFBundleTypeRole": "Viewer", "CFBundleURLIconFile": "CameraIcon"]],
    ], entitlements: ["com.apple.security.application-groups": ["group.com.jibunkit.build-camera"]]),
    .init(owner: "scanner", infoPlist: [
        "NSCameraUsageDescription": "Scan documents", "UIBackgroundModes": ["processing", "audio"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.jibunkit.build-scanner.refresh"],
        "CFBundleURLTypes": [["CFBundleURLName": "com.jibunkit.scanner", "CFBundleURLSchemes": ["scanner", "shared"],
                              "CFBundleTypeRole": "Editor"]],
    ], localizedInfoPlist: [
        "en": ["NSCameraUsageDescription": "Scan documents", "CFBundleDisplayName": "Build Probe"],
        "ja": ["NSCameraUsageDescription": "書類を撮影", "CFBundleDisplayName": "ビルド検証"],
    ]),
    .init(owner: "camera-localized", localizedInfoPlist: [
        "en": ["NSCameraUsageDescription": "Take photos", "CFBundleDisplayName": "Build Probe"],
        "ja": ["NSCameraUsageDescription": "写真を撮影", "CFBundleDisplayName": "ビルド検証"],
    ]),
], infoPlistResolutions: ["NSCameraUsageDescription": "Camera takes photos; Scanner scans documents"],
localizedInfoPlistResolutions: [
    "en": ["NSCameraUsageDescription": "Use camera to scan documents"],
    "ja": ["NSCameraUsageDescription": "カメラで書類を撮影します"],
])
    .compose(infoPlist: ["UILaunchScreen": [:],
        "CFBundleURLTypes": [["CFBundleURLName": "com.jibunkit.host", "CFBundleURLSchemes": ["host"]]],
    ], entitlements: [
        "com.apple.security.application-groups": ["group.com.jibunkit.shared"],
    ])
let widgetBuild = try FeatureBuildConfiguration(features: [
    .init(owner: "widget", localizedInfoPlist: [
        "en": ["CFBundleDisplayName": "Build Probe Widget"],
        "ja": ["CFBundleDisplayName": "ビルド検証ウィジェット"],
    ])
]).compose(infoPlist: [
    "NSExtension": ["NSExtensionPointIdentifier": "com.apple.widgetkit-extension"],
], entitlements: [:])
let staleBuild = try FeatureBuildConfiguration(features: [
    .init(owner: "removed", localizedInfoPlist: ["fr": ["CFBundleDisplayName": "Obsolète"]])
]).compose(infoPlist: [:], entitlements: [:])
try staleBuild.writeLocalizedInfoPlistStrings(to: "GeneratedResources/AppInfo")
try build.writeLocalizedInfoPlistStrings(to: "GeneratedResources/AppInfo")
try widgetBuild.writeLocalizedInfoPlistStrings(to: "GeneratedResources/WidgetInfo")

let project = Project(name: "BuildRequirementProbe", targets: [
    .target(name: "BuildRequirementProbe", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.build-probe", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: build.infoPlist), sources: ["App.swift"],
        resources: ["GeneratedResources/AppInfo/**"], entitlements: .dictionary(build.entitlements),
        dependencies: [.target(name: "BuildRequirementProbeWidget")]),
    .target(name: "BuildRequirementProbeWidget", destinations: .iOS, product: .appExtension,
        bundleId: "com.jibunkit.build-probe.Widget", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: widgetBuild.infoPlist), sources: ["Widget.swift"],
        resources: ["GeneratedResources/WidgetInfo/**"])
])
