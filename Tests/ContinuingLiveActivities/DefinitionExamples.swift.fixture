// Copy the relevant fields into each normal-host MiniAppDefinition after the
// parent's continuingSurfaces property lands. These use the same app singleton
// as LiveActivityIntent and do not tie activity lifetime to a screen.
//
// let aService = FeatureALiveActivityService.shared
// MiniAppDefinition(...,
//     continuingSurfaces: [try await aService.surface()],
//     makeRootView: { _ in FeatureADiagnosticView() })
//
// let bService = FeatureBLiveActivityService.shared
// MiniAppDefinition(...,
//     continuingSurfaces: [try await bService.surface()],
//     makeRootView: { _ in FeatureBDiagnosticView() })
//
// Host lifecycle semantics:
// disable/delete: surface.close() -> surface.endOwned() -> removal
// restore stop:   surface.close() -> surface.endOwned() -> replace payload
// failed stop:    surface.open() only if management still permits access
// launch/resume:  surface.reconcile() -> surface.open(); never auto-start
