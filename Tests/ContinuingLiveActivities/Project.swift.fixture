import ProjectDescription

let variants: [(String, [String])] = [("StandaloneA", ["A"]), ("StandaloneB", ["B"]), ("Combined", ["A", "B"])]
var targets: [Target] = []
for (name, letters) in variants {
    let bundleID = "com.jibunkit.continuing-live.\(name.lowercased())"
    let group = "group.\(bundleID)"
    let features: [TargetDependency] = letters.map { .package(product: "ContinuingFeature\($0)") }
    targets.append(.target(name: "\(name)Widget", destinations: .iOS, product: .appExtension,
        bundleId: "\(bundleID).widget", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["JibunKitAppGroup": .string(group),
            "NSExtension": ["NSExtensionPointIdentifier": "com.apple.widgetkit-extension"]]),
        sources: [.glob("\(name)Widget.swift")],
        entitlements: .dictionary(["com.apple.security.application-groups": .array([.string(group)])]),
        dependencies: features))
    targets.append(.target(name: name, destinations: .iOS, product: .app, bundleId: bundleID,
        deploymentTargets: .iOS("26.0"), infoPlist: .extendingDefault(with: [
            "CFBundleDisplayName": .string("Live \(name)"), "JibunKitAppGroup": .string(group),
            "NSSupportsLiveActivities": .boolean(true), "UILaunchScreen": [:]]),
        sources: [.glob("\(name)Host.swift")],
        entitlements: .dictionary(["com.apple.security.application-groups": .array([.string(group)])]),
        dependencies: [.target(name: "\(name)Widget"), .package(product: "JibunKitCore")] + features))
}
targets.append(.target(name: "ContinuingLiveActivityNativeTests", destinations: .iOS, product: .unitTests,
    bundleId: "com.jibunkit.continuing-live.tests", deploymentTargets: .iOS("26.0"), infoPlist: .default,
    sources: ["NativeTests.swift"], dependencies: [.target(name: "Combined"), .package(product: "JibunKitCore"),
        .package(product: "ContinuingFeatureA"), .package(product: "ContinuingFeatureB")]))
let project = Project(name: "ContinuingLiveActivities", packages: [
    .package(path: "FeatureA"), .package(path: "FeatureB"), .package(path: "__JIBUNKIT_PATH__")],
    settings: .settings(base: ["SWIFT_VERSION": "6.0"]), targets: targets)
