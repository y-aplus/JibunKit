import ProjectDescription
import ProjectDescriptionHelpers

let shortcutA = FeatureAppShortcuts(owner: "a", imports: ["IntentFeatureA"],
    sourceFile: "FeatureA/AppShortcuts.swift.fragment")
let shortcutB = FeatureAppShortcuts(owner: "b", imports: ["IntentFeatureB"],
    sourceFile: "FeatureB/AppShortcuts.swift.fragment")
let includeShortcutA = true
try FeatureAppShortcuts.writeProvider([shortcutA], to: "Generated/ComposedShortcutsA.swift")
try FeatureAppShortcuts.writeProvider([shortcutB], to: "Generated/ComposedShortcutsB.swift")
try FeatureAppShortcuts.writeProvider(includeShortcutA ? [shortcutA, shortcutB] : [shortcutB],
    to: "Generated/ComposedShortcutsCombined.swift")


let project = Project(name: "PackageIntents", packages: [
    .package(path: "FeatureA"), .package(path: "FeatureB"), .package(path: "__JIBUNKIT_PATH__"),
], targets: [
    .target(name: "StandaloneA", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.a", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "StandaloneA.swift"], dependencies: [.package(product: "IntentFeatureA")]),
    .target(name: "StandaloneB", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.b", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "StandaloneB.swift"], dependencies: [.package(product: "IntentFeatureB")]),
    .target(name: "Combined", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.combined", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "Combined.swift"],
        dependencies: [.package(product: "IntentFeatureA"), .package(product: "IntentFeatureB")]),
    .target(name: "IntentExecutionTests", destinations: .iOS, product: .unitTests,
        bundleId: "com.jibunkit.intent-fixture.tests", deploymentTargets: .iOS("26.0"),
        infoPlist: .default, sources: ["IntentExecutionTests.swift", "IntentIntegration.swift"],
        dependencies: [.target(name: "Combined"), .package(product: "IntentFeatureA"), .package(product: "IntentFeatureB"), .package(product: "JibunKitCore")]),
    .target(name: "OwnedShortcutsA", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.shortcuts.a", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "OwnedShortcutsA.swift", "Generated/ComposedShortcutsA.swift"],
        dependencies: [.package(product: "IntentFeatureA")]),
    .target(name: "OwnedShortcutsB", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.shortcuts.b", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "OwnedShortcutsB.swift", "Generated/ComposedShortcutsB.swift"],
        dependencies: [.package(product: "IntentFeatureB")]),
    .target(name: "OwnedShortcutsCombined", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.intent-fixture.shortcuts.combined", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift", "OwnedShortcutsCombined.swift", "Generated/ComposedShortcutsCombined.swift"],
        dependencies: [.package(product: "IntentFeatureA"), .package(product: "IntentFeatureB")]),
], schemes: [
    .scheme(name: "IntentExecutionTests", shared: true,
            buildAction: .buildAction(targets: ["Combined"]),
            testAction: .targets(["IntentExecutionTests"]))
])
