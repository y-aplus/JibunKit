import Foundation
import ProjectDescription

let includeA = ProcessInfo.processInfo.environment["PRIVACY_INCLUDE_A"] != "0"
let appPackages: [Package] = includeA
    ? [.package(path: "FeatureA"), .package(path: "FeatureB")]
    : [.package(path: "FeatureB")]
let appDependencies: [TargetDependency] = includeA
    ? [.package(product: "PrivacyFeatureA"), .package(product: "PrivacyFeatureB"), .target(name: "PrivacyHostWidget")]
    : [.package(product: "PrivacyFeatureB"), .target(name: "PrivacyHostWidget")]

let project = Project(name: "PrivacyHost", packages: appPackages, targets: [
    .target(name: "PrivacyHost", destinations: .iOS, product: .app,
        bundleId: "com.jibunkit.privacy-host", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
        sources: ["App.swift"], dependencies: appDependencies),
    .target(name: "PrivacyHostWidget", destinations: .iOS, product: .appExtension,
        bundleId: "com.jibunkit.privacy-host.Widget", deploymentTargets: .iOS("26.0"),
        infoPlist: .extendingDefault(with: ["NSExtension": ["NSExtensionPointIdentifier": "com.apple.widgetkit-extension"]]),
        sources: ["Widget.swift"], dependencies: [.package(product: "PrivacyFeatureB")]),
])
