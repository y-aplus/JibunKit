import ProjectDescription

let project = Project(
    name: "{{ name }}Example",
    packages: [.package(path: ".")],
    settings: .settings(base: ["SWIFT_VERSION": "6.0"]),
    targets: [
        .target(
            name: "{{ name }}Example", destinations: .iOS, product: .app,
            bundleId: "com.jibunkit.example.{{ name | lowercase }}",
            deploymentTargets: .iOS("26.0"),
            infoPlist: .extendingDefault(with: ["UILaunchScreen": [:]]),
            sources: ["Example/**"],
            dependencies: [.package(product: "{{ name }}Feature")]
        ),
        .target(
            name: "{{ name }}ExampleUITests", destinations: .iOS, product: .uiTests,
            bundleId: "com.jibunkit.example.{{ name | lowercase }}.uitests",
            deploymentTargets: .iOS("26.0"),
            infoPlist: .default, sources: ["UITests/**"],
            dependencies: [.target(name: "{{ name }}Example")]
        ),
    ],
    schemes: [
        .scheme(name: "{{ name }}Example", shared: true,
                buildAction: .buildAction(targets: ["{{ name }}Example"]),
                testAction: .targets(["{{ name }}ExampleUITests"], configuration: .debug)),
    ]
)
